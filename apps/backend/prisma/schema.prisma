generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The NestJS build emits CommonJS; ESM output would use import.meta,
  // which Node's syntax detection then misclassifies at runtime.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core schema (user/session/account/verification).
// better-auth owns these tables and generates record IDs itself.

enum AssistantPersona {
  professional
  casual
  supportive
  firm
  motivator
}

model User {
  id                     String                 @id
  name                   String
  email                  String                 @unique
  emailVerified          Boolean                @default(false)
  image                  String?
  role                   String                 @default("user")
  banned                 Boolean                @default(false)
  banReason              String?
  banExpires             DateTime?
  timezone               String                 @default("Asia/Jakarta")
  locale                 String                 @default("id")
  onboardingCompleted    Boolean                @default(false)
  automaticMemoryEnabled Boolean                @default(false)
  persona                AssistantPersona       @default(supportive)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now()) @updatedAt
  sessions               Session[]
  accounts               Account[]
  externalIdentities     ExternalIdentity[]
  auditEvents            AuditEvent[]
  conversations          Conversation[]
  messages               Message[]
  tasks                  Task[]
  categories             Category[]
  reminders              Reminder[]
  memories               Memory[]
  fileAssets             FileAsset[]
  documents              Document[]
  contacts               Contact[]
  calendarIntegrations   CalendarIntegration[]
  calendarEvents         CalendarEvent[]
  whatsappLinkCodes      WhatsAppLinkCode[]
  notificationDeliveries NotificationDelivery[]
  userPreference         UserPreference?

  @@index([role])
  @@index([banned])
  @@map("user")
}

model ExternalIdentity {
  id              String                   @id @default(cuid())
  userId          String
  provider        String
  externalId      String
  verifiedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @default(now()) @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappState   WhatsAppContactState?
  inboundMessages WhatsAppInboundMessage[]

  @@unique([provider, externalId])
  @@index([userId])
  @@map("external_identity")
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  metadata  Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_event")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Conversation {
  id                      String                @id @default(cuid())
  userId                  String
  channel                 String                @default("web")
  title                   String?
  rollingSummary          String?
  summaryThroughMessageId String?
  lastMessageAt           DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages                Message[]
  summaries               ConversationSummary[]
  assistantRuns           AssistantRun[]

  @@index([userId, lastMessageAt])
  @@map("conversation")
}

model Message {
  id                String              @id @default(cuid())
  conversationId    String
  userId            String
  role              String
  type              String              @default("text")
  content           String
  providerMessageId String?
  attachments       MessageAttachment[]
  idempotencyKey    String?
  createdAt         DateTime            @default(now())
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputForRuns      AssistantRun[]      @relation("AssistantRunInput")

  @@unique([conversationId, providerMessageId])
  @@unique([userId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@map("message")
}

model ConversationSummary {
  id               String       @id @default(cuid())
  conversationId   String
  content          String
  throughMessageId String
  createdAt        DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_summary")
}

model AssistantRun {
  id                 String           @id @default(cuid())
  conversationId     String
  inputMessageId     String
  idempotencyKey     String           @unique
  assistantMessageId String?
  retryOfRunId       String?
  status             String           @default("queued")
  provider           String
  model              String
  errorMessage       String?
  costUsd            Decimal?         @db.Decimal(18, 8)
  inputTokens        Int?
  outputTokens       Int?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inputMessage       Message          @relation("AssistantRunInput", fields: [inputMessageId], references: [id], onDelete: Cascade)
  toolInvocations    ToolInvocation[]

  @@index([model])
  @@index([conversationId, createdAt])
  @@index([inputMessageId, createdAt])
  @@map("assistant_run")
}

model ToolInvocation {
  id             String       @id @default(cuid())
  assistantRunId String
  toolCallId     String
  name           String
  label          String
  status         String       @default("pending")
  arguments      Json
  result         Json?
  errorMessage   String?
  idempotencyKey String       @unique
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  assistantRun   AssistantRun @relation(fields: [assistantRunId], references: [id], onDelete: Cascade)

  @@unique([assistantRunId, toolCallId])
  @@index([assistantRunId, createdAt])
  @@map("tool_invocation")
}

model Task {
  id              String         @id @default(cuid())
  userId          String
  title           String
  description     String?
  status          String         @default("inbox")
  priority        String         @default("medium")
  dueAt           DateTime?
  sourceType      String         @default("dashboard")
  sourceMessageId String?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories      TaskCategory[]

  @@index([userId, status, dueAt])
  @@index([userId, updatedAt])
  @@map("task")
}

model Category {
  id             String         @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  color          String
  iconKey        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          TaskCategory[]

  @@unique([userId, normalizedName])
  @@index([userId, name])
  @@map("category")
}

model TaskCategory {
  taskId     String
  categoryId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([taskId, categoryId])
  @@index([categoryId])
  @@map("task_category")
}

model Reminder {
  id              String               @id @default(cuid())
  userId          String
  title           String
  notes           String?
  status          String               @default("scheduled")
  scheduledAt     DateTime
  timezone        String
  recurrence      Json?
  sourceType      String               @default("dashboard")
  sourceMessageId String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences     ReminderOccurrence[]

  @@index([userId, status, scheduledAt])
  @@index([userId, updatedAt])
  @@map("reminder")
}

model ReminderOccurrence {
  id                     String                 @id @default(cuid())
  reminderId             String
  occurrenceAt           DateTime
  idempotencyKey         String                 @unique
  status                 String                 @default("pending")
  providerMessageId      String?
  attemptedAt            DateTime?
  deliveredAt            DateTime?
  errorMessage           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now()) @updatedAt
  reminder               Reminder               @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  notificationDeliveries NotificationDelivery[]

  @@unique([reminderId, occurrenceAt])
  @@index([status, occurrenceAt])
  @@map("reminder_occurrence")
}

model Memory {
  id               String                       @id @default(cuid())
  userId           String
  content          String
  category         String?
  status           String                       @default("active")
  pinned           Boolean                      @default(false)
  confidence       Float?
  sourceType       String                       @default("dashboard")
  sourceMessageId  String?
  sourceDocumentId String?
  extractorVersion String?
  supersedesId     String?
  supersededById   String?
  embedding        Unsupported("vector(1536)")?
  embeddingModel   String?
  embeddingVersion String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @default(now()) @updatedAt
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, pinned])
  @@index([userId, updatedAt])
  @@map("memory")
}

model FileAsset {
  id           String              @id @default(cuid())
  userId       String
  originalName String
  mimeType     String
  size         Int
  checksum     String
  storageKey   String              @unique
  kind         String
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     Document?
  messages     MessageAttachment[]

  @@index([userId, createdAt])
  @@map("file_asset")
}

model MessageAttachment {
  messageId   String
  fileAssetId String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@id([messageId, fileAssetId])
  @@map("message_attachment")
}

model Document {
  id               String          @id @default(cuid())
  userId           String
  fileAssetId      String          @unique
  status           String          @default("processing")
  title            String
  textContent      String?
  transcript       String?
  imageDescription String?
  structuredData   Json?
  errorMessage     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileAsset        FileAsset       @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  chunks           DocumentChunk[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("document")
}

model DocumentChunk {
  id               String                       @id @default(cuid())
  documentId       String
  userId           String
  chunkIndex       Int
  pageNumber       Int?
  content          String
  embedding        Unsupported("vector(1536)")?
  embeddingModel   String?
  embeddingVersion String?
  createdAt        DateTime                     @default(now())
  document         Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId, documentId])
  @@map("document_chunk")
}

model Contact {
  id             String   @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  aliases        String[] @default([])
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, normalizedName])
  @@index([userId, updatedAt])
  @@map("contact")
}

model CalendarIntegration {
  id                   String    @id @default(cuid())
  userId               String
  provider             String    @default("google")
  status               String    @default("disconnected")
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  scope                String?
  calendarId           String?   @default("primary")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("calendar_integration")
}

model CalendarEvent {
  id              String   @id @default(cuid())
  userId          String
  provider        String   @default("local")
  providerEventId String?
  title           String
  description     String?
  location        String?
  startAt         DateTime
  endAt           DateTime
  timezone        String
  attendees       String[] @default([])
  status          String   @default("confirmed")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerEventId])
  @@index([userId, startAt, status])
  @@map("calendar_event")
}

model WhatsAppGatewayState {
  id                String    @id @default("default")
  status            String    @default("disconnected")
  registrationReady Boolean   @default(false)
  profileReady      Boolean   @default(false)
  sendingPaused     Boolean   @default(false)
  enforcementCode   String?
  enforcementReason String?
  recoveryReason    String?
  lastConnectedAt   DateTime?
  lastEventAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@map("whatsapp_gateway_state")
}

model WhatsAppLinkCode {
  id                   String    @id @default(cuid())
  userId               String
  codeHash             String    @unique
  expiresAt            DateTime
  consumedAt           DateTime?
  consumedByExternalId String?
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("whatsapp_link_code")
}

model WhatsAppContactState {
  id                       String           @id @default(cuid())
  externalIdentityId       String           @unique
  firstInboundAt           DateTime?
  firstResponseAt          DateTime?
  optedOutAt               DateTime?
  lastInboundAt            DateTime?
  lastProactiveSentAt      DateTime?
  lastProactiveReplyAt     DateTime?
  unansweredProactiveCount Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @default(now()) @updatedAt
  externalIdentity         ExternalIdentity @relation(fields: [externalIdentityId], references: [id], onDelete: Cascade)

  @@index([optedOutAt, lastProactiveReplyAt])
  @@map("whatsapp_contact_state")
}

model WhatsAppInboundMessage {
  id                 String            @id @default(cuid())
  provider           String
  providerMessageId  String
  senderExternalId   String
  externalIdentityId String?
  receivedAt         DateTime
  processedAt        DateTime?
  createdAt          DateTime          @default(now())
  externalIdentity   ExternalIdentity? @relation(fields: [externalIdentityId], references: [id], onDelete: SetNull)

  @@unique([provider, providerMessageId])
  @@index([senderExternalId, receivedAt])
  @@index([externalIdentityId, receivedAt])
  @@map("whatsapp_inbound_message")
}

model NotificationDelivery {
  id                   String                        @id @default(cuid())
  userId               String
  kind                 String
  content              String
  idempotencyKey       String                        @unique
  proactive            Boolean                       @default(false)
  sourceId             String?
  providerMessageId    String?
  status               String                        @default("pending")
  policyOutcome        String?
  attemptedAt          DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  lastError            String?
  reminderOccurrenceId String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @default(now()) @updatedAt
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderOccurrence   ReminderOccurrence?           @relation(fields: [reminderOccurrenceId], references: [id], onDelete: SetNull)
  attempts             NotificationDeliveryAttempt[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([proactive, createdAt])
  @@map("notification_delivery")
}

model NotificationDeliveryAttempt {
  id                String               @id @default(cuid())
  deliveryId        String
  attemptNumber     Int
  providerMessageId String?
  status            String
  errorMessage      String?
  attemptedAt       DateTime             @default(now())
  deliveredAt       DateTime?
  createdAt         DateTime             @default(now())
  delivery          NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([status, attemptedAt])
  @@map("notification_delivery_attempt")
}

model WhatsAppTrafficDaily {
  id             String   @id @default(cuid())
  day            DateTime @db.Date
  inboundCount   Int      @default(0)
  outboundCount  Int      @default(0)
  proactiveCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([day])
  @@map("whatsapp_traffic_daily")
}

model WhatsAppOutboundReservation {
  id         String   @id
  day        DateTime @db.Date
  proactive  Boolean  @default(false)
  reservedAt DateTime

  @@index([reservedAt])
  @@index([day, proactive])
  @@map("whatsapp_outbound_reservation")
}

model UserPreference {
  userId                       String   @id
  assistantVerbosity           String   @default("balanced")
  assistantStyle               String   @default("supportive")
  briefingEnabled              Boolean  @default(false)
  briefingTime                 String?
  webNotificationsEnabled      Boolean  @default(true)
  whatsappNotificationsEnabled Boolean  @default(true)
  emailNotificationsEnabled    Boolean  @default(false)
  proactivePaused              Boolean  @default(false)
  retentionDays                Int?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @default(now()) @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}
