generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The NestJS build emits CommonJS; ESM output would use import.meta,
  // which Node's syntax detection then misclassifies at runtime.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core schema (user/session/account/verification).
// better-auth owns these tables and generates record IDs itself.

model User {
  id                  String             @id
  name                String
  email               String             @unique
  emailVerified       Boolean            @default(false)
  image               String?
  timezone            String             @default("Asia/Jakarta")
  locale              String             @default("id")
  onboardingCompleted Boolean            @default(false)
  automaticMemoryEnabled Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  sessions            Session[]
  accounts            Account[]
  externalIdentities  ExternalIdentity[]
  auditEvents         AuditEvent[]
  conversations       Conversation[]
  messages            Message[]
  tasks                 Task[]
  reminders             Reminder[]
  memories              Memory[]


  @@map("user")
}

model ExternalIdentity {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  externalId String
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
  @@map("external_identity")
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  metadata  Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_event")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Conversation {
  id                      String                @id @default(cuid())
  userId                  String
  channel                 String                @default("web")
  title                   String?
  rollingSummary          String?
  summaryThroughMessageId String?
  lastMessageAt           DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages                Message[]
  summaries               ConversationSummary[]
  assistantRuns           AssistantRun[]

  @@index([userId, lastMessageAt])
  @@map("conversation")
}

model Message {
  id                String         @id @default(cuid())
  conversationId    String
  userId            String
  role              String
  type              String         @default("text")
  content           String
  providerMessageId String?
  idempotencyKey    String?
  createdAt         DateTime       @default(now())
  conversation      Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputForRuns      AssistantRun[] @relation("AssistantRunInput")

  @@unique([conversationId, providerMessageId])
  @@unique([userId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@map("message")
}

model ConversationSummary {
  id               String       @id @default(cuid())
  conversationId   String
  content          String
  throughMessageId String
  createdAt        DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_summary")
}

model AssistantRun {
  id                 String           @id @default(cuid())
  conversationId     String
  inputMessageId     String
  idempotencyKey     String           @unique
  assistantMessageId String?
  retryOfRunId       String?
  status             String           @default("queued")
  provider           String
  model              String
  errorMessage       String?
  inputTokens        Int?
  outputTokens       Int?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inputMessage       Message          @relation("AssistantRunInput", fields: [inputMessageId], references: [id], onDelete: Cascade)
  toolInvocations    ToolInvocation[]

  @@index([conversationId, createdAt])
  @@index([inputMessageId, createdAt])
  @@map("assistant_run")
}

model ToolInvocation {
  id             String       @id @default(cuid())
  assistantRunId String
  toolCallId     String
  name           String
  label          String
  status         String       @default("pending")
  arguments      Json
  result         Json?
  errorMessage   String?
  idempotencyKey String       @unique
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  assistantRun   AssistantRun @relation(fields: [assistantRunId], references: [id], onDelete: Cascade)

  @@unique([assistantRunId, toolCallId])
  @@index([assistantRunId, createdAt])
  @@map("tool_invocation")
}

model Task {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  status          String    @default("inbox")
  priority        String    @default("medium")
  dueAt           DateTime?
  tags            String[]  @default([])
  sourceType      String    @default("dashboard")
  sourceMessageId String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([userId, updatedAt])
  @@map("task")
}

model Reminder {
  id              String               @id @default(cuid())
  userId          String
  title           String
  notes           String?
  status          String               @default("scheduled")
  scheduledAt     DateTime
  timezone        String
  recurrence      Json?
  sourceType      String               @default("dashboard")
  sourceMessageId String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences     ReminderOccurrence[]

  @@index([userId, status, scheduledAt])
  @@index([userId, updatedAt])
  @@map("reminder")
}

model ReminderOccurrence {
  id                String    @id @default(cuid())
  reminderId        String
  occurrenceAt      DateTime
  idempotencyKey    String    @unique
  status            String    @default("pending")
  providerMessageId String?
  attemptedAt       DateTime?
  deliveredAt       DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  reminder          Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, occurrenceAt])
  @@index([status, occurrenceAt])
  @@map("reminder_occurrence")
}

model Memory {
  id                String    @id @default(cuid())
  userId            String
  content           String
  category          String?
  status            String    @default("active")
  pinned            Boolean   @default(false)
  confidence        Float?
  sourceType        String    @default("dashboard")
  sourceMessageId   String?
  sourceDocumentId  String?
  extractorVersion  String?
  supersedesId      String?
  supersededById    String?
  embedding         Unsupported("vector(1536)")?
  embeddingModel    String?
  embeddingVersion  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, pinned])
  @@index([userId, updatedAt])
  @@map("memory")
}
