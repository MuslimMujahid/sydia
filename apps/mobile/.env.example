# Copy to apps/mobile/.env. Expo inlines EXPO_PUBLIC_* variables at bundle time.
#
# URL of the Sydia backend as seen from the phone or emulator — not from your
# computer. `localhost` only works in the iOS simulator.
# - Physical device on the same Wi-Fi: http://<your-computer-LAN-IP>:5000
# - Android emulator:                  http://10.0.2.2:5000
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
