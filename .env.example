# Shared environment for the whole monorepo.
# scripts/setup-env.js symlinks this file (as .env) into apps/frontend and apps/backend.
# Convention: shared variables are prefixed with the app that owns the value
# (FRONTEND_* / BACKEND_*), while Vite public variables use the VITE_* prefix.

# Frontend dev-server port. Also used by the backend to build its CORS origin.
FRONTEND_PORT=3000

# Canonical frontend origin used by backend CORS and Better Auth trusted origins.
# Must be an absolute http/https URL with no path, query, or hash.
FRONTEND_URL=http://localhost:3000

# Backend listen port.
BACKEND_PORT=5000

# URL the frontend uses to reach the backend (inlined by Vite at build time).
VITE_API_URL=http://localhost:5000

# PostgreSQL connection URL. The backend, the Prisma CLI, and the seed script
# all read this single value. Percent-encode reserved characters in the password.
BACKEND_DB_URL=postgresql://postgres:postgres@localhost:5432/app

# Component values for the development container in docker/docker-compose.dev.yml,
# which cannot consume a URL. Keep them in sync with BACKEND_DB_URL.
BACKEND_DB_PORT=5432
BACKEND_DB_USER=postgres
BACKEND_DB_PASSWORD=postgres
BACKEND_DB_NAME=app

# Redis connection URL for the BullMQ queues that drive delayed reminder
# delivery and worker coordination. Percent-encode reserved characters.
BACKEND_REDIS_URL=redis://localhost:6379

# Host port for the development container in docker/docker-compose.dev.yml,
# which cannot consume a URL. Keep it in sync with BACKEND_REDIS_URL.
BACKEND_REDIS_PORT=6379

# Better Auth session-signing secret. Dev-only placeholder; generate a real
# random value (e.g. `openssl rand -base64 32`) for any deployed environment.
BACKEND_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Optional dedicated key for encrypting Google OAuth tokens at rest. Falls back
# to BACKEND_AUTH_SECRET when unset.
BACKEND_TOKEN_ENCRYPTION_KEY=
# Dedicated key for encrypting user vault secrets. Required and intentionally
# separate from authentication and provider-token keys.
BACKEND_SECRET_ENCRYPTION_KEY=change-me-to-a-distinct-random-string-of-at-least-32-characters

# Base URL of the auth server. Defaults to http://localhost:$BACKEND_PORT when unset.
BACKEND_AUTH_URL=http://localhost:5000

# OpenRouter language model gateway for interactive assistant requests.
# The API key is required to produce assistant responses; missing configuration is
# persisted as a failed assistant run so the web UI can offer retry.
BACKEND_MODEL_API_KEY=
BACKEND_MODEL_BASE_URL=https://openrouter.ai/api/v1
BACKEND_MODEL_NAME=z-ai/glm-5.3-flash
# OpenRouter model: https://openrouter.ai/z-ai/glm-5.3-flash
# OpenRouter model: https://openrouter.ai/openai/text-embedding-3-small
BACKEND_EMBEDDING_MODEL=openai/text-embedding-3-small

# Langfuse Cloud tracing for the Japan region. Leave keys empty in the template
# and provide your project credentials only in the ignored .env file.
# The self-hosted development Langfuse stack remains separately available at
# http://localhost:3100; its local initialization credentials are defined in
# docker/docker-compose.dev.yml.
BACKEND_LANGFUSE_PUBLIC_KEY=
BACKEND_LANGFUSE_SECRET_KEY=
BACKEND_LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Bounded conversation context and rolling-summary thresholds (estimated tokens).
BACKEND_ASSISTANT_CONTEXT_TOKENS=6000
BACKEND_SUMMARY_TRIGGER_TOKENS=4500
BACKEND_SUMMARY_RETAIN_MESSAGES=8
# Internal debugging features. Leave false in production.
VITE_DEBUG_ENABLED=false
# User-facing WhatsApp linking surfaces (shown under /settings/integrations).
# Leave false to hide the integration from production; admins keep
# /admin/whatsapp regardless.
VITE_WHATSAPP_ENABLED=false

# Incremental memory dreaming: process after idle, substantial segments first,
# then recover shorter conversations after six hours.
BACKEND_MEMORY_DREAM_IDLE_MS=900000
BACKEND_MEMORY_DREAM_MIN_USER_MESSAGES=4
BACKEND_MEMORY_DREAM_MIN_TOKENS=800
BACKEND_MEMORY_DREAM_SHORT_SEGMENT_AGE_MS=21600000
# Maximum cosine distance accepted by durable-memory semantic retrieval.
BACKEND_MEMORY_MAX_COSINE_DISTANCE=0.3

# Optional S3-compatible private file storage. Without a bucket, files use the local root.
# Keep the endpoint origin-only (scheme and host, with no bucket path); configure the
# bucket separately. Leave both credential fields empty, or provide both together.
BACKEND_STORAGE_LOCAL_ROOT=.data/files
BACKEND_STORAGE_BUCKET=
BACKEND_STORAGE_REGION=auto
BACKEND_STORAGE_ENDPOINT=
BACKEND_STORAGE_ACCESS_KEY=
BACKEND_STORAGE_SECRET_KEY=
# Vision and speech-to-text models use the existing OpenRouter key.
BACKEND_VISION_MODEL=google/gemini-2.5-flash
BACKEND_STT_MODEL=openai/whisper-large-v3-turbo

# Optional Google Calendar OAuth web-server integration. Local calendar events
# remain available when these values are empty.
BACKEND_GOOGLE_CLIENT_ID=
BACKEND_GOOGLE_CLIENT_SECRET=
BACKEND_GOOGLE_REDIRECT_URI=http://localhost:5000/calendar/google/callback

# WhatsApp gateway (go-whatsapp-web-multidevice). The companion runs as a
# separate HTTP service; the backend talks to it over HTTP and receives inbound
# events via webhooks. Build/run the binary with apps/backend/scripts/gowa-*.
BACKEND_WHATSAPP_RUNTIME_ENABLED=true
BACKEND_WHATSAPP_GOWA_URL=http://127.0.0.1:3001
BACKEND_WHATSAPP_GOWA_DEVICE_ID=sydia
BACKEND_WHATSAPP_WEBHOOK_SECRET=dev-secret
BACKEND_WHATSAPP_LOCK_PATH=.data/whatsapp
BACKEND_WHATSAPP_COMMAND_TIMEOUT=30000
BACKEND_WHATSAPP_STATUS_POLL_MS=15000
